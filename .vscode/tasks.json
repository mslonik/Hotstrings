{
     // See https://go.microsoft.com/fwlink/?LinkId=733558
     // for the documentation about the tasks.json format
     "version": "2.0.0",
     "tasks": 
	[
          {
               "label": 	"Hotstrings.ahk  → Hotstrings.exe and compress",
               "type": 	"shell",
               "windows":
			{
                    "command": 	"c:\\Program Files\\AutoHotkey\\Compiler\\Ahk2Exe.exe",
                    "args":   	[
                              	"/in",         "${file}", 
                              	"/out",        "${fileBasenameNoExtension}.exe", 
                              	"/icon",       "${fileBasenameNoExtension}.ico",
                              	"/bin",        "c:\\Program Files\\AutoHotkey\\Compiler\\Unicode 64-bit.bin",
                              	"/cp",         "65001",                                                          //Unicode (UTF-8)
                              	"/compress",   "2"                                                               //2 = Upx.exe 
                              	]
               },
               "group": "build",
               "presentation": 
			{
                    "echo": 			false,
				"revealProblems": 	"onProblem",
                    "focus": 			false,
                    "panel": 			"shared",
                    "showReuseMessage": false,
                    "clear": 			true
               }
          },
		{
			"label": 	"Prepare Hotstrings2.exe",
			"type": 	"shell",
			"windows":
			{
				"command": 	"Copy-Item",
				"args": 		[
							"c:\\Users\\macie\\Documents\\GitHub\\Hotstrings\\Hotstrings.exe",
							"-Destination",
							"c:\\Users\\macie\\Documents\\GitHub\\Hotstrings2\\Hotstrings2.exe"
							],
			},
			"dependsOrder":	"sequence",
			"dependsOn":		["Hotstrings.ahk  → Hotstrings.exe and compress"],
			"group": 			"build",
			"presentation":
			{
                    "echo": 			false,
                    "revealProblems": 	"onProblem",
                    "focus": 			false,
                    "panel": 			"shared",
                    "showReuseMessage": false,
                    "clear": 			true
               }
		},
	]
}

